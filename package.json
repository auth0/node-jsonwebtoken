{
  "name": "jsonwebtoken",
  "version": "9.0.4",
  "description": "JSON Web Token implementation (symmetric and asymmetric)",
  "keywords": [
    "jwt"
  ],
  "author": "auth0",
  "exports": {
    ".": {
      "module": {
        "types": "./dist/esm/index.d.ts",
        "import": "./dist/esm/index.js"
      },
      "import": {
        "types": "./dist/esm/index.d.ts",
        "node": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "require": "./dist/cjs/index.js"
      }
    }
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "files": [
    "./dist/**",
    "./package.json",
    "./package-lock.json",
    "./tsconfig.json",
    "./tsconfig.build.json",
    "./tsconfig.cjs.json",
    "./tsconfig.esm.json",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "prebuild": "rimraf dist",
    "build:cjs": "tsc --project tsconfig.cjs.json && tsc-alias --project tsconfig.cjs.json",
    "build:esm": "tsc --project tsconfig.esm.json && tsc-alias --project tsconfig.esm.json",
    "build": "npm run build:cjs && npm run build:esm",
    "lint": "eslint .",
    "test": "jest --passWithNoTests",
    "test:ci": "jest --passWithNoTests --ci",
    "test:watch": "jest --passWithNoTests --watch",
    "test:watchAll": "jest --passWithNoTests --watchAll",
    "test:coverage": "jest --passWithNoTests --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "jws": "^3.2.2",
    "ms": "^2.1.1",
    "semver": "^7.5.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@eslint/js": "^9.24.0",
    "@jest/globals": "^29.7.0",
    "@swc/jest": "^0.2.37",
    "@types/jws": "^3.2.10",
    "@types/ms": "^2.1.0",
    "@types/node": "^22.14.0",
    "@types/semver": "^7.7.0",
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.29.0",
    "atob": "^2.1.2",
    "eslint": "^9.24.0",
    "eslint-plugin-prettier": "^5.2.6",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "tsc-alias": "^1.8.13",
    "typescript": "^5.8.3"
  },
  "engines": {
    "npm": ">=6",
    "node": ">=12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/auth0/node-jsonwebtoken"
  },
  "bugs": {
    "url": "https://github.com/auth0/node-jsonwebtoken/issues"
  },
  "license": "MIT"
}
